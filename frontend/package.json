{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:strict && npm run size-check && tsc -b && vite build",
    "lint": "eslint .",
    "lint:strict": "eslint . --config .eslintrc.strict.js",
