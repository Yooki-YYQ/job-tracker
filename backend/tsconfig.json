{
  "compilerOptions": {
    // all compiled products into dist and source code into src
    "rootDir": "./src",
    "outDir": "./dist",

    // Node backend
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    // Common compatibility items
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // Types and strict mode
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Debugging
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
